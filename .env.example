# Draft the Stars v2 - environment variables.
# Copy to .env.local. EVERYTHING IS OPTIONAL TODAY: the app runs on the in-memory mock data layer,
# placeholder auth and the mock payment provider. No outside service is connected.

# --- Site ---
NEXT_PUBLIC_SITE_URL=
# mock (default) | supabase (TODO: adapter not implemented yet)
DATA_ADAPTER=

# --- Supabase (Postgres, Auth, Realtime, RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# direct Postgres connection for migrations / the league import (server only)
SUPABASE_DB_URL=

# --- Stripe (member fees: $5 per slot; commissioner can cover several slots in one checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# optional: a Stripe Price for "1 member slot" ($5.00 one-time platform fee; Checkout quantity = slots paid);
# otherwise price_data is built from src/lib/billing/config.ts
STRIPE_PRICE_ID_LEAGUE_MEMBER=

# --- Resend (email: verification, reset, invites, reminders) ---
RESEND_API_KEY=
# e.g. "Draft the Stars <hello@your-domain>" (needs a verified domain)
EMAIL_FROM=

# --- Sentry (errors) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
